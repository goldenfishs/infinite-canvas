[Unit]
Description=Lumivia canvas account bridge
After=network.target

[Service]
LoadCredential=canvas-key-seed:/etc/lumivia-canvas/key-seed
ExecStart=/usr/bin/python3 /opt/infinite-canvas/lumivia/bridge.py
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
