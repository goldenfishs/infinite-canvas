[Unit]
Description=Lumivia canvas account bridge
After=network.target

[Service]
LoadCredential=canvas-key-seed:/etc/lumivia-canvas/key-seed
ExecStart=@CANVAS_RELEASE@/venv/bin/python @CANVAS_RELEASE@/lumivia/bridge.py
Restart=on-failure
DynamicUser=yes
StateDirectory=lumivia-canvas
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
